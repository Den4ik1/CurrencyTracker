<Window x:Class="CurrencyTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="700" Width="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="20,10">
            <telerik:RadDatePicker SelectedDate="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Margin="0,0,10,0"/>
            <telerik:RadDatePicker SelectedDate="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Margin="0,0,10,0"/>
            <Button Content="Выгрузить"
                    Width="100"
                    Command="{Binding SaveRatesCommand}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <telerik:RadGridView Grid.Column="0"
                                 ItemsSource="{Binding Currency}"
                                 SelectedItem="{Binding SelectedCurrency, Mode=TwoWay}"
                                 SelectionMode="Single"
                                 SelectionUnit="FullRow"
                                 AutoGenerateColumns="False">
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn Header="Числовой код"   DataMemberBinding="{Binding CurCode}"         Width="80"/>
                    <telerik:GridViewDataColumn Header="Буквенный код"  DataMemberBinding="{Binding CurAbbreviation}" Width="80"/>
                    <telerik:GridViewDataColumn Header="Название валюты" DataMemberBinding="{Binding CurName}"         Width="*"/>
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>

            <telerik:RadGridView Grid.Column="1"
                                 ItemsSource="{Binding Rates}"
                                 SelectionUnit="FullRow"
                                 AutoGenerateColumns="False"
                                 Margin="10,0,0,0">
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn Header="Дата" DataMemberBinding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="150"/>
                    <telerik:GridViewDataColumn Header="Курс" DataMemberBinding="{Binding CurOfficialRate}"            Width="*"/>
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
        </Grid>

        <telerik:RadCartesianChart Grid.Row="2" Margin="10">
            <telerik:RadCartesianChart.HorizontalAxis>
                <telerik:DateTimeCategoricalAxis LabelFormat="{}{0:dd.MM.yyyy}"
                                                 LabelFitMode="Rotate"/>
            </telerik:RadCartesianChart.HorizontalAxis>
            <telerik:RadCartesianChart.VerticalAxis>
                <telerik:LinearAxis Title="{Binding SelectedCurrency.CurName}"/>
            </telerik:RadCartesianChart.VerticalAxis>
            <telerik:RadCartesianChart.Series>
                <telerik:LineSeries ItemsSource="{Binding Rates}"
                                    CategoryBinding="Date"
                                    ValueBinding="CurOfficialRate"
                                    Stroke="Red"
                                    StrokeThickness="2"/>
            </telerik:RadCartesianChart.Series>
        </telerik:RadCartesianChart>
    </Grid>
</Window>